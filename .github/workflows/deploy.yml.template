# CD 自动部署 workflow 模板 (E1)
#
# 这个文件是 .template - 复制为 deploy.yml 并填入 secrets 后启用。
# CI (ci.yml) 已覆盖 lint/test/build/e2e 硬门；本 job 在 master push 时
# 在服务器上就地构建（与 docker-compose.prod.yml 的 build-only 服务一致 —
# compose 里的 backend/celery 用 Dockerfile.cloud、frontend 用 Dockerfile.prod，
# 没有 image: 标签，registry pull 环节对它们是空转）。
#
# 启用步骤：
#   1. cp .github/workflows/deploy.yml.template .github/workflows/deploy.yml
#   2. 在 GitHub repo Settings -> Secrets 配置:
#      - SSH_HOST            服务器 IP
#      - SSH_USER            SSH 用户
#      - SSH_KEY             SSH 私钥
#      - DEPLOY_PATH         服务器上 repo 路径 (如 /opt/seeword)
#   3. 确认服务器上 docker-compose.prod.yml + .env + nginx/ssl 证书已就绪
#   4. 取消下方 needs: 的注释，部署将仅在 CI 全绿后执行
#
# 本模板部署 backend + celery + celery-beat + frontend；GPU worker 镜像
# 变化少，按需手动构建（backend/Dockerfile）。

name: Deploy

on:
  push:
    branches: [master, main]
    # 只在与部署相关的路径变更时触发
    paths:
      - "backend/**"
      - "frontend/**"
      - "docker-compose*.yml"
      - "nginx*.conf"
      - "promtail.yml"
      - ".github/workflows/deploy.yml"
  workflow_dispatch: # 手动触发

jobs:
  deploy:
    runs-on: ubuntu-latest
    # 仅 CI 通过后部署。启用时取消注释并确保 ci.yml 的 job id 匹配：
    # needs: [backend, frontend, e2e]
    steps:
      - uses: actions/checkout@v4

      - name: Deploy to server (build in place)
        uses: appleboy/ssh-action@v1
        with:
          host: ${{ secrets.SSH_HOST }}
          username: ${{ secrets.SSH_USER }}
          key: ${{ secrets.SSH_KEY }}
          script: |
            set -e
            cd ${{ secrets.DEPLOY_PATH }}
            git pull --ff-only
            # 就地构建 compose 实际消费的镜像（Dockerfile.cloud / Dockerfile.prod）。
            docker compose -f docker-compose.prod.yml build backend celery celery-beat frontend
            docker compose -f docker-compose.prod.yml up -d --remove-orphans
            # 健康检查 - 走 nginx 对外端口（backend 仅 expose 8000，未发布到宿主机）
            curl -sf --retry 30 --retry-delay 5 --retry-connrefused https://seeword.top/health || \
              curl -sf --retry 10 --retry-delay 3 --retry-connrefused http://localhost/health
            echo "Deployed at $(date)"
