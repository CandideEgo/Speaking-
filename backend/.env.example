# =============================================================================
# SeeWord — Environment Variables
# =============================================================================
# Copy this file to .env and fill in real values.
# All values below are placeholders — replace with real secrets in production.
# =============================================================================

# -- Application --
# APP_NAME=SeeWord
# DEBUG=false

# -- Environment --
# ENV=development  # development / production / testing

# =============================================================================
# -- Required: Database & Redis --
# =============================================================================
DATABASE_URL=postgresql+asyncpg://seeword:seeword_dev@localhost:5432/seeword
REDIS_URL=redis://localhost:6379/0

# =============================================================================
# -- Required: JWT Authentication --
# =============================================================================
# At least 32 characters (a short HS256 key is cheap to brute-force).
# Generate one with: openssl rand -hex 32
JWT_SECRET=replace-with-openssl-rand-hex-32-output
# JWT_ALGORITHM=HS256
# JWT_EXPIRE_MINUTES=30  # access token TTL (minutes; frontend auto-refreshes)
# JWT_REFRESH_EXPIRE_DAYS=7  # refresh token TTL (days)

# =============================================================================
# -- Required: AI Provider (OpenAI-compatible API) --
# =============================================================================
# Legacy fallback provider: AIService prefers COMMANDCODE_* (below) when its
# key is set, and only uses these when COMMANDCODE_API_KEY is empty.
OPENAI_API_KEY=your-api-key-here
OPENAI_BASE_URL=https://apihub.agnes-ai.com/v1
# OPENAI_MODEL=agnes-2.0-flash

# =============================================================================
# -- LLM provider: Command Code (OpenAI-compatible, free models by default) --
# =============================================================================
# 视频管线（字幕翻译 / 词注释 / 视频分类）与首页编辑草稿都走这一套配置。
# 「provider + 模型目录 + 哪些模型免费」的唯一事实源是
# backend/app/services/llm_provider.py（口径来自供应商定价页，2026-10-20 核对）。
# 免费模型是促销性质（供应商可随时撤），上线前与日常巡检都跑：
#   cd backend && python scripts/check_llm_provider.py --list   # 拉 /models 对账
#   cd backend && python scripts/check_llm_provider.py --test   # 真实冒烟
# COMMANDCODE_API_KEY=user_xxx
# COMMANDCODE_BASE_URL=https://api.commandcode.ai/provider/v1
# COMMANDCODE_MODEL=minimax/minimax-m3.1-flash:free  # 默认免费模型：1M 上下文、无日限、支持 ZDR
# COMMANDCODE_ZDR=false        # true = 每次请求带 x-cmd-zdr:1；须同时锁定支持 ZDR 的模型
#                              # （beam:free / glyph-cluster:free 不支持，会硬失败）
# LLM_CALL_TIMEOUT=90          # 单次 LLM 调用超时（秒）

# -- 按任务换模型（留空 = COMMANDCODE_MODEL；任务定义在 llm_provider.py）--
# LLM_MODEL_TRANSLATION=       # 批量字幕翻译
# LLM_MODEL_WORD_NOTES=        # 词注释 / 词义补充
# LLM_MODEL_CLASSIFICATION=    # 视频 topic / 难度分类
# LLM_MODEL_EDITORIAL=         # 首页编辑草稿（可用 reflection/beam:free：1M、无日限）

# -- Command Code 免费模型（2026-10-20，促销口径）--
# minimax/minimax-m3.1-flash:free   1M、无日限、ZDR（限时免费，默认模型）
# reflection/beam:free              1M、无日限、不支持 ZDR
# poolside/laguna-s-2.1-free        256K、无日限、偶发上游不可用
# stealth/glyph-cluster:free        256K、100 次/天、不支持 ZDR

# =============================================================================
# -- Optional: Translation Engine (pluggable) --
# =============================================================================
# TRANSLATION_ENGINE=qwen              # qwen | hy_mt2 | agnes | glm | custom | commandcode (default: qwen)
# TRANSLATION_FALLBACK_ENGINE=hy_mt2   # paired with primary for concurrent mode (default: hy_mt2)
# TRANSLATION_CONCURRENT=true          # run primary + fallback concurrently, first valid wins (default: true)
# TRANSLATION_BATCH_SIZE=20            # subtitles per LLM call
# TRANSLATION_HYMT2_API_KEY=           # iFLYTEK API key (shared for Hy-MT2 & Qwen)
# TRANSLATION_QWEN_API_KEY=            # iFLYTEK API key (shared for Hy-MT2 & Qwen)
# TRANSLATION_CUSTOM_BASE_URL=         # custom OpenAI-compatible endpoint
# TRANSLATION_CUSTOM_API_KEY=          # custom endpoint API key
# TRANSLATION_CUSTOM_MODEL=            # custom endpoint model name
# Command Code 免费模型跑翻译：commandcode 引擎复用 COMMANDCODE_*；另一条免费
# 路线可借 custom 槽位指向同 provider 的另一个免费模型，凑成「主 + 兜底」并发：
#   TRANSLATION_ENGINE=commandcode
#   TRANSLATION_FALLBACK_ENGINE=custom
#   TRANSLATION_CUSTOM_BASE_URL=https://api.commandcode.ai/provider/v1
#   TRANSLATION_CUSTOM_MODEL=reflection/beam:free
#   TRANSLATION_CUSTOM_API_KEY=<与 COMMANDCODE_API_KEY 相同>
#   PREWARM_ENGINES=commandcode,custom

# =============================================================================
# -- Optional: Local media storage --
# =============================================================================
# LOCAL_MEDIA_PATH=./media

# =============================================================================
# -- Optional: Upload settings --
# =============================================================================
# UPLOAD_TEMP_DIR=./uploads
# MAX_UPLOAD_FILE_SIZE=524288000  # 500MB

# =============================================================================
# -- Optional: Video CDN (Alibaba Cloud OSS) --
# =============================================================================
# OSS_ENDPOINT=oss-cn-hongkong.aliyuncs.com
# OSS_BUCKET=your-bucket
# OSS_ACCESS_KEY=your-oss-access-key
# OSS_SECRET_KEY=your-oss-secret-key
# OSS_CDN_DOMAIN=cdn.seeword.top         # CDN domain serving the bucket
# OSS_UPLOAD_ENABLED=false                     # Set true to upload transcoded videos to OSS
# OSS_PREFIX=videos/                           # Path prefix in bucket
# OSS_CLEANUP_LOCAL=false                      # Delete local transcoded files after OSS upload
# -- Remote-GPU transcription: OSS raw-media transfer (cloud uploads local
#    uploads to OSS and hands the GPU worker a signed URL).
# OSS_RAW_PREFIX=video/raw                     # OSS key prefix for staged raw uploads
# OSS_RAW_BUCKET_PUBLIC=false                  # false = private bucket, use signed URLs
# OSS_SIGNED_URL_EXPIRY=7200                   # signed-URL lifetime (≥ max queue wait + transcribe)

# =============================================================================
# -- Alibaba Cloud SMS (Dypnsapi) — phone login verification code --
# =============================================================================
# When SMS_LOGIN_ENABLED=false (or AK/SK empty), the sms_service uses a dev
# fake: it logs the code and accepts the fixed value "1234" — no Aliyun calls.
# That fake is opt-in: set SMS_DEV_FAKE_ENABLED=true for local dev / CI. It is
# refused when ENV=production, and a deployment that forgot ENV fails closed
# instead of accepting "1234" on any phone account.
# Set SMS_LOGIN_ENABLED=true + AK/SK to send real SMS via Dypnsapi.
# SMS_LOGIN_ENABLED=false
# SMS_DEV_FAKE_ENABLED=true
# ALIYUN_SMS_ACCESS_KEY=your-aliyun-access-key
# ALIYUN_SMS_SECRET_KEY=your-aliyun-secret-key
# ALIYUN_SMS_SIGN_NAME=速通互联验证码
# ALIYUN_SMS_TEMPLATE_CODE=100001

# =============================================================================
# -- Remote-GPU transcription pipeline (cloud side) --
# =============================================================================
# Video subtitles are transcribed on a separate GPU machine (remote Celery
# worker on the transcription_gpu queue) and POSTed back here. The cloud runs
# zero Whisper for the video pipeline.
# TRANSCRIPTION_CALLBACK_URL=https://api.seeword.top/api/v1/internal/transcription/callback
# TRANSCRIPTION_CALLBACK_SECRET=shared-secret                  # authenticates inbound callbacks
# TRANSCRIPTION_GPU_QUEUE_NAME=transcription_gpu
# TRANSCRIPTION_CALLBACK_TIMEOUT=30                            # seconds per HTTP attempt
# TRANSCRIPTION_CALLBACK_MAX_RETRIES=5                         # 5xx / connection retries
# VIDEO_TRANSCRIBE_TIMEOUT=7200                                # watchdog: fail stuck "transcribing" (s)


# =============================================================================
# -- Optional: Payment (Alipay) --
# =============================================================================
# ALIPAY_APP_ID=your-alipay-app-id
# ALIPAY_PUBLIC_KEY=your-alipay-public-key
# ALIPAY_PRIVATE_KEY=your-alipay-private-key

# =============================================================================
# -- Optional: Payment (WeChat Pay) --
# =============================================================================
# WECHAT_MCH_ID=your-wechat-merchant-id
# WECHAT_API_V3_KEY=your-wechat-api-v3-key
# WECHAT_SERIAL_NO=your-wechat-cert-serial-no
# 验签默认开启（fail-closed，审计 H12）。仅 development 可显式关闭用于本地联调，
# 关闭时有 warning 日志；production 一律强制验签。
# PAYMENT_VERIFY_SIGNATURE=false

# =============================================================================
# -- 金数据（外部收款页）→ 自动开通 Pro --
# =============================================================================
# 站内仍不开收款（ICP 合规）：会员在托管于金数据的收款页成交后，由 Celery
# beat 定时同步 + 数据推送 webhook 自动延长对应手机号账号的 Pro 有效期。
# Access Token 在金数据后台「个人中心 → API」创建，只放服务端 env。
# JINSHUJU_ENABLED=false
# JINSHUJU_ACCESS_TOKEN=your-jinshuju-access-token
# JINSHUJU_FORM_TOKEN=your-form-token          # 表单短链里的 token，例如 ed8TXL
# JINSHUJU_WEBHOOK_SECRET=random-long-secret   # 数据推送 URL 上的 ?secret=
# JINSHUJU_TIER_FIELD=field_2                  # 档位（商品）字段 api_code
# JINSHUJU_PHONE_FIELD=field_5                 # 手机号字段 api_code
# JINSHUJU_SYNC_LOOKBACK_HOURS=72
# 站内购买（B 方案）：快捷收款页地址 + 写在 x_field_1 的签名 token。
# JINSHUJU_PURCHASE_URL=https://your-subdomain.jsjform.com/p/FORMTOKEN
# JINSHUJU_PURCHASE_TOKEN_SECRET=random-long-secret
# JINSHUJU_PURCHASE_TOKEN_TTL_MINUTES=1440

# =============================================================================
# -- Optional: YouTube cookies for yt-dlp admin downloads --
# =============================================================================
# To get cookies: python get_youtube_cookies.py --from-session
# Or manually: playwright-cli open https://youtube.com --persistent
#             playwright-cli state-save youtube_cookies.txt
# YOUTUBE_COOKIES_PATH=./youtube_cookies.txt

# =============================================================================
# -- Optional: Proxy for yt-dlp / AI API --
# =============================================================================
# HTTP_PROXY=http://127.0.0.1:7890

# =============================================================================
# -- Whisper / transcription settings moved out of the cloud --
# =============================================================================
# The GPU transcription worker is now the standalone ``gpu-worker/`` component.
# Its WHISPER_* / TRANSCRIPTION_TEMP_DIR settings live in
# ``gpu-worker/.env.gpu-worker.example`` — the cloud backend does not run
# Whisper and must not set them.

# =============================================================================
# -- Optional: Frontend URL for CORS --
# =============================================================================
# FRONTEND_URL=http://localhost:3000

# =============================================================================
# -- Optional: CSP connect-src domains (space-separated) --
# =============================================================================
# CSP_CONNECT_DOMAINS=https://api.openai.com https://gateway.agnes.ai

# =============================================================================
# -- Optional: Observability --
# =============================================================================
# SENTRY_DSN=your-sentry-dsn
# LOG_LEVEL=INFO

# =============================================================================
# -- Optional: SMTP / Email (for password reset) --
# =============================================================================
# If SMTP_HOST is empty, password reset links are logged to stdout instead of sending email.
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_USER=your-smtp-user
# SMTP_PASSWORD=your-smtp-password
# SMTP_FROM_EMAIL=noreply@example.com
# SMTP_USE_TLS=true
# PASSWORD_RESET_EXPIRE_MINUTES=30

# =============================================================================
# -- Remote GPU transcription worker: NOT configured here --
# =============================================================================
# The GPU worker is the standalone ``gpu-worker/`` component (its own
# requirements, .env.gpu-worker*, start scripts and NSSM services). It connects
# to this cloud's Redis through an SSH tunnel and consumes only the
# transcription_gpu queue — it needs NO DATABASE_URL and NO OSS credentials.
#
# ``gpu-worker/.env.gpu-worker.example`` is the single source of truth for its
# WHISPER_* / callback / proxy / cookies settings.
