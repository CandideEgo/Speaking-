# ---- Cloud worker Dockerfile (no Whisper/GPU models) ----
# For the cloud server that does NOT run transcription.
# Uses requirements-cloud.txt which excludes torch/whisperx/faster-whisper
# (saves ~1GB+ image size and 10+ min build time on low-memory servers).
#
# Usage in docker-compose.prod.yml:
#   build:
#     context: ./backend
#     dockerfile: Dockerfile.cloud

# ---- Stage 1: builder ----
FROM python:3.12.12-slim AS builder

WORKDIR /app

# ffmpeg is still needed for audio format handling (e.g. speaking practice uploads).
RUN sed -i 's/deb.debian.org/mirrors.aliyun.com/g' /etc/apt/sources.list.d/debian.sources 2>/dev/null; \
    apt-get update && apt-get install -y --no-install-recommends \
    ffmpeg \
    && rm -rf /var/lib/apt/lists/*

COPY requirements-cloud.txt .
RUN pip config set global.index-url https://mirrors.aliyun.com/pypi/simple/ && \
    pip install --no-cache-dir -r requirements-cloud.txt

# Skip Whisper model pre-download — cloud server does not run transcription.
# The models are only needed on the GPU worker.

COPY . .

# ---- Stage 2: runtime ----
FROM python:3.12.12-slim

WORKDIR /app

# Non-root runtime user (least privilege — the app must not run as root).
RUN useradd --create-home --uid 1000 app

# ffmpeg for audio format handling. nodejs for yt-dlp EJS (YouTube n-challenge
# signature solving) — without a JS runtime yt-dlp only gets image formats.
RUN sed -i 's/deb.debian.org/mirrors.aliyun.com/g' /etc/apt/sources.list.d/debian.sources 2>/dev/null; \
    apt-get update && apt-get install -y --no-install-recommends \
    ffmpeg \
    nodejs \
    && rm -rf /var/lib/apt/lists/*

# Copy installed Python packages from builder
COPY --from=builder /usr/local/lib/python3.12/site-packages /usr/local/lib/python3.12/site-packages
COPY --from=builder /usr/local/bin /usr/local/bin

# Copy application code (no model cache)
COPY --from=builder /app /app
RUN chown -R app:app /app

# Entrypoint runs alembic migrations before the app server starts.
COPY entrypoint.sh /app/entrypoint.sh
RUN chmod +x /app/entrypoint.sh

USER app

EXPOSE 8000

HEALTHCHECK --interval=30s --timeout=5s --start-period=20s --retries=3 \
    CMD python -c "import urllib.request; urllib.request.urlopen('http://127.0.0.1:8000/health', timeout=3)"

# Default to the migration entrypoint + uvicorn. docker-compose can override
# the args to use gunicorn instead, but should keep the entrypoint so migrations
# run on every container start.
ENTRYPOINT ["/app/entrypoint.sh"]
CMD ["uvicorn", "app.main:app", "--host", "0.0.0.0", "--port", "8000"]
