# 本地开发可复制为 .env.local；生产通过 Docker 构建参数传入。
# NEXT_PUBLIC_* 会在构建时固定，修改后需重新构建前端镜像。
# API 与媒体始终使用同源 /api、/media，不配置浏览器后端地址。
NEXT_PUBLIC_SITE_URL=https://seeword.top

# ===== ICP 合规与运营配置 =====
# 只填写已核实的公示信息；未配置的字段不展示。
# 会员配置在后端，购买链接与价格由接口返回。
NEXT_PUBLIC_COMPANY_NAME=
NEXT_PUBLIC_COMPANY_USCC=
NEXT_PUBLIC_ICP_BEIAN=
NEXT_PUBLIC_POLICE_BEIAN=
